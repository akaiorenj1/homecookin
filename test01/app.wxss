/* ===================================
   家常厨房 - 全局样式系统
   =================================== */

/* ---- 设计令牌 ---- */
page {
  --color-primary: #ff6b35;
  --color-primary-light: #ff8c5a;
  --color-primary-dark: #e55a2b;
  --color-accent: #f7931e;
  --color-bg: #faf7f2;
  --color-card: #ffffff;
  --color-text: #2d3436;
  --color-text-secondary: #636e72;
  --color-text-muted: #b2bec3;
  --color-border: #f0ece4;
  --color-success: #00b894;
  --color-danger: #ff4757;
  --color-warning: #ffa502;
  --color-info: #3742fa;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-full: 999rpx;
  --shadow-sm: 0 2rpx 8rpx rgba(0,0,0,0.04);
  --shadow-md: 0 4rpx 20rpx rgba(0,0,0,0.08);
  --shadow-lg: 0 8rpx 40rpx rgba(0,0,0,0.12);
  --font-xs: 22rpx;
  --font-sm: 26rpx;
  --font-md: 30rpx;
  --font-lg: 36rpx;
  --font-xl: 44rpx;
  --font-xxl: 56rpx;

  background-color: var(--color-bg);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: var(--font-sm);
  color: var(--color-text);
  box-sizing: border-box;
}

/* ---- 通用容器 ---- */
.container {
  padding: 24rpx;
  min-height: 100vh;
}

/* ---- 卡片 ---- */
.card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.card--hover {
  transition: transform 0.2s, box-shadow 0.2s;
}
.card--hover:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

/* ---- 按钮系统 ---- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  padding: 20rpx 40rpx;
  font-size: var(--font-md);
  font-weight: 600;
  border: none;
  transition: all 0.2s;
}

.btn-primary {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(255,107,53,0.3);
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.97);
}

.btn-secondary {
  background: var(--color-bg);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.btn-danger {
  background: var(--color-danger);
  color: #fff;
}

.btn-sm {
  padding: 12rpx 24rpx;
  font-size: var(--font-xs);
  border-radius: var(--radius-sm);
}

.btn-block {
  display: flex;
  width: 100%;
}

/* ---- 输入框 ---- */
.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
  font-weight: 500;
}

.input-field {
  width: 100%;
  background: var(--color-bg);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: var(--font-md);
  color: var(--color-text);
  box-sizing: border-box;
}

.input-field:focus {
  border-color: var(--color-primary);
}

/* ---- 标签/分类 ---- */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-xs);
  font-weight: 500;
}

.tag--primary {
  background: rgba(255,107,53,0.1);
  color: var(--color-primary);
}

.tag--success {
  background: rgba(0,184,148,0.1);
  color: var(--color-success);
}

.tag--danger {
  background: rgba(255,71,87,0.1);
  color: var(--color-danger);
}

.tag--warning {
  background: rgba(255,165,2,0.1);
  color: var(--color-warning);
}

/* ---- 分类标签栏 ---- */
.category-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  overflow-x: auto;
  white-space: nowrap;
}

.category-bar::-webkit-scrollbar { display: none; }

.category-item {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-sm);
  background: var(--color-card);
  color: var(--color-text-secondary);
  transition: all 0.2s;
}

.category-item.active {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(255,107,53,0.3);
}

/* ---- 空状态 ---- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-state .empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-state .empty-text {
  font-size: var(--font-md);
  color: var(--color-text-muted);
}

/* ---- 加载 ---- */
.loading-container {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
}

/* ---- 弹窗 ---- */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.modal-content {
  width: 100%;
  background: var(--color-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 40rpx 32rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: var(--font-lg);
  font-weight: 700;
}

.modal-close {
  font-size: 40rpx;
  color: var(--color-text-muted);
  padding: 8rpx;
}

/* ---- 全局按钮行 ---- */
.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn-row .btn {
  flex: 1;
}

/* ---- 文本省略 ---- */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---- 间距工具 ---- */
.mt-sm { margin-top: 12rpx; }
.mt-md { margin-top: 24rpx; }
.mt-lg { margin-top: 40rpx; }
.mb-sm { margin-bottom: 12rpx; }
.mb-md { margin-bottom: 24rpx; }
