.header {
  padding: 40rpx 0 32rpx;
}

.greeting {
  display: block;
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.date-sub {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

/* 快捷入口 */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.quick-card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 28rpx 16rpx;
  text-align: center;
  box-shadow: var(--shadow-sm);
  position: relative;
}

.quick-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.quick-label {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.quick-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 20rpx;
  border-radius: var(--radius-full);
  text-align: center;
  padding: 0 8rpx;
}

.quick-badge.badge-warning {
  background: var(--color-danger);
}

/* 今日推荐滚动 */
.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 700;
  margin-bottom: 20rpx;
}

.recipe-scroll {
  display: flex;
  white-space: nowrap;
}

.recipe-card-sm {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
  margin-right: 20rpx;
}

.recipe-img-sm {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  margin-bottom: 8rpx;
}

.recipe-img-placeholder {
  width: 120rpx;
  height: 120rpx;
  background: var(--color-bg);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-bottom: 8rpx;
}

.recipe-name-sm {
  font-size: var(--font-xs);
  color: var(--color-text);
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 提醒卡片 */
.alert-card {
  display: flex;
  align-items: center;
  background: rgba(255,71,87,0.06);
  border: 2rpx solid rgba(255,71,87,0.2);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.alert-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.alert-content {
  flex: 1;
}

.alert-title {
  display: block;
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-danger);
}

.alert-desc {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.alert-arrow {
  font-size: var(--font-md);
  color: var(--color-text-muted);
}

/* 管理入口 */
.admin-section {
  margin-top: 40rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--color-border);
}

.admin-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.link-arrow {
  color: var(--color-text-muted);
}
