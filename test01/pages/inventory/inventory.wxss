.alert-strip {
  display: flex;
  align-items: center;
  background: rgba(255,71,87,0.08);
  border-radius: var(--radius-md);
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.alert-strip-icon { font-size: var(--font-md); margin-right: 12rpx; }

.alert-strip-text {
  font-size: var(--font-sm);
  color: var(--color-danger);
  font-weight: 500;
}

/* 库存卡片 */
.inventory-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.inventory-card.card--low {
  border: 2rpx solid rgba(255,71,87,0.3);
  background: rgba(255,71,87,0.02);
}

.inv-left { flex: 1; }

.inv-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
  display: block;
  margin-bottom: 8rpx;
}

.inv-meta {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.inv-unit {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

.inv-right {
  text-align: right;
}

.inv-qty {
  display: block;
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
}

.inv-qty.qty--low {
  color: var(--color-danger);
}

.inv-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
  justify-content: flex-end;
}

.inv-action-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-md);
}

.inv-action-del {
  color: var(--color-danger);
}

/* 底部工具栏 */
.bottom-toolbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--color-card);
  display: flex;
  gap: 16rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
  z-index: 10;
}

.bottom-toolbar .btn {
  flex: 1;
}

/* OCR */
.ocr-item {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 12rpx;
}

.ocr-item .input-field {
  flex: 1;
}

.ocr-del {
  font-size: var(--font-md);
  color: var(--color-danger);
  padding: 8rpx;
}

.empty-sub {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
  margin-top: 8rpx;
}
