.inventory-header {
  background: linear-gradient(180deg, #6b8e23 0%, #556b2f 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border: 4rpx solid #3d4a1d;
  box-shadow: 4rpx 4rpx 0 #3d4a1d;
}

.header-left {
  flex: 1;
}

.header-right {
  display: flex;
  gap: 16rpx;
}

.inventory-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff8dc;
  text-shadow: 2rpx 2rpx 0 #3d4a1d;
}

.inventory-tip {
  font-size: 22rpx;
  color: #deb887;
  margin-top: 8rpx;
}

.ocr-btn, .logs-btn {
  background-color: rgba(255, 248, 220, 0.2);
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fff8dc;
  border: 2rpx solid #3d4a1d;
}

.inventory-list {
  padding-bottom: 120rpx;
}

.inventory-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff8dc;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 3rpx solid #8b4513;
  box-shadow: 4rpx 4rpx 0 rgba(139, 69, 19, 0.2);
}

.inventory-info {
  flex: 1;
}

.inventory-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #5c4033;
}

.inventory-category {
  font-size: 20rpx;
  color: #a0522d;
  margin-top: 4rpx;
}

.inventory-quantity {
  text-align: right;
  margin-right: 16rpx;
}

.quantity-value {
  font-size: 34rpx;
  font-weight: bold;
  color: #6b8e23;
}

.quantity-unit {
  font-size: 22rpx;
  color: #8b4513;
  margin-left: 4rpx;
}

.item-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: bold;
  border: 2rpx solid #3d4a1d;
}

.action-btn.add {
  background-color: #6b8e23;
  color: #fff8dc;
  box-shadow: 2rpx 2rpx 0 #3d4a1d;
}

.action-btn.waste {
  background-color: #cd853f;
  color: #fff8dc;
  box-shadow: 2rpx 2rpx 0 #8b4513;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #a0522d;
}

.empty-subtip {
  display: block;
  font-size: 22rpx;
  margin-top: 10rpx;
}

.loading {
  text-align: center;
  padding: 30rpx;
  color: #a0522d;
}

.add-inventory-btn {
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: #cd853f;
  color: #fff8dc;
  font-size: 28rpx;
  font-weight: bold;
  padding: 20rpx 50rpx;
  border-radius: 12rpx;
  border: 4rpx solid #8b4513;
  box-shadow: 4rpx 4rpx 0 #8b4513;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(92, 64, 51, 0.7);
  z-index: 100;
}

.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  background-color: #fff8dc;
  border-radius: 16rpx;
  padding: 30rpx;
  z-index: 101;
  border: 4rpx solid #8b4513;
  box-shadow: 6rpx 6rpx 0 rgba(139, 69, 19, 0.4);
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 10rpx;
  color: #5c4033;
}

.ocr-tip {
  text-align: center;
  font-size: 22rpx;
  color: #a0522d;
  margin-bottom: 20rpx;
}

.form-value {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  background-color: #fffaf0;
  border: 3rpx solid #8b4513;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #5c4033;
  box-sizing: border-box;
}

.ocr-result-list {
  max-height: 400rpx;
  overflow-y: auto;
  margin-bottom: 20rpx;
}

.ocr-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.ocr-input {
  flex: 1;
  height: 64rpx;
  background-color: #fffaf0;
  border: 2rpx solid #8b4513;
  border-radius: 6rpx;
  padding: 0 14rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}

.name-input {
  flex: 2;
}

.quantity-input {
  flex: 1;
}

.ocr-delete {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  color: #cd5c5c;
  font-size: 32rpx;
  font-weight: bold;
}

.modal-form {
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #8b4513;
  margin-bottom: 10rpx;
  font-weight: bold;
}

.form-input {
  width: 100%;
  height: 72rpx;
  background-color: #fffaf0;
  border: 3rpx solid #8b4513;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.form-input[disabled] {
  color: #a0522d;
}

.picker-value {
  width: 100%;
  height: 72rpx;
  background-color: #fffaf0;
  border: 3rpx solid #8b4513;
  border-radius: 8rpx;
  padding: 0 20rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  gap: 14rpx;
}

.modal-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: bold;
  border: 3rpx solid #3d4a1d;
}

.modal-btn.cancel {
  background-color: #f5deb3;
  color: #5c4033;
}

.modal-btn.confirm {
  background-color: #6b8e23;
  color: #fff8dc;
  box-shadow: 3rpx 3rpx 0 #3d4a1d;
}

.modal-btn.confirm.waste {
  background-color: #cd853f;
}

.modal-btn.add-more {
  background-color: #f5deb3;
  color: #6b8e23;
  font-size: 24rpx;
}
