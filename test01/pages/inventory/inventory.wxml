<view class="container">
  <!-- 库存预警 -->
  <view wx:if="{{lowStockAlerts.length > 0}}" class="alert-strip">
    <text class="alert-strip-icon">⚠️</text>
    <text class="alert-strip-text">{{lowStockAlerts.length}} 种食材库存偏低</text>
  </view>

  <!-- 库存列表 -->
  <view wx:if="{{!loading && inventoryList.length === 0}}" class="empty-state">
    <text class="empty-icon">🧺</text>
    <text class="empty-text">库存空空如也</text>
    <text class="empty-sub">拍照识别小票或手动添加</text>
    <view class="btn-row mt-lg">
      <button class="btn btn-primary" bindtap="showAddModal">手动添加</button>
      <button class="btn btn-secondary" bindtap="chooseImage">📷 拍照识别</button>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="inventory-list">
    <view 
      wx:for="{{inventoryList}}" 
      wx:key="_id" 
      class="inventory-card card {{item.isLow ? 'card--low' : ''}}"
    >
      <view class="inv-left">
        <text class="inv-name">{{item.name}}</text>
        <view class="inv-meta">
          <text class="tag tag--primary">{{item.categoryText}}</text>
          <text class="inv-unit">单位: {{item.unit}}</text>
        </view>
      </view>
      <view class="inv-right">
        <text class="inv-qty {{item.isLow ? 'qty--low' : ''}}">{{item.quantity}}</text>
        <view class="inv-actions">
          <text class="inv-action-btn" bindtap="showAddModal" data-item="{{item}}">＋</text>
          <text class="inv-action-btn inv-action-del" bindtap="showWasteModal" data-item="{{item}}">🗑</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="loading-container"><text>加载中...</text></view>

  <!-- 底部工具栏 -->
  <view class="bottom-toolbar">
    <button class="btn btn-primary btn-sm" bindtap="showAddModal">手动入库</button>
    <button class="btn btn-secondary btn-sm" bindtap="chooseImage">📷 小票识别</button>
    <button class="btn btn-secondary btn-sm" bindtap="goToLogs">📊 记录</button>
  </view>

  <!-- 入库弹窗 -->
  <view wx:if="{{showModal}}" class="modal-mask" bindtap="hideModal">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">{{modalType === 'add' ? '新增食材' : '补充库存'}}</text>
        <text class="modal-close" bindtap="hideModal">✕</text>
      </view>
      <view wx:if="{{modalType === 'add'}}" class="input-group">
        <text class="input-label">食材名称</text>
        <input class="input-field" value="{{newInventory.name}}" bindinput="onNameInput" placeholder="例如: 猪肉" />
      </view>
      <view wx:else class="input-group">
        <text class="input-label">食材: {{newInventory.name}}</text>
      </view>
      <view class="input-group">
        <text class="input-label">数量</text>
        <input class="input-field" type="digit" value="{{newInventory.quantity}}" bindinput="onQuantityInput" placeholder="输入数量" />
      </view>
      <view class="input-group">
        <text class="input-label">单位</text>
        <picker mode="selector" range="{{units}}" value="{{unitIndex}}" bindchange="onUnitChange">
          <view class="input-field">{{units[unitIndex]}}</view>
        </picker>
      </view>
      <button class="btn btn-primary btn-block mt-md" bindtap="submitInventory" disabled="{{submitting}}">
        {{submitting ? '保存中...' : '确认入库'}}
      </button>
    </view>
  </view>

  <!-- 报废弹窗 -->
  <view wx:if="{{showWasteModal}}" class="modal-mask" bindtap="closeWasteModal">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">报废 - {{wasteItem.name}}</text>
        <text class="modal-close" bindtap="closeWasteModal">✕</text>
      </view>
      <text class="input-label">当前库存: {{wasteItem.quantity}}{{wasteItem.unit}}</text>
      <view class="input-group mt-md">
        <text class="input-label">报废数量</text>
        <input class="input-field" type="digit" value="{{wasteQuantity}}" bindinput="onWasteQuantityInput" placeholder="输入报废数量" />
      </view>
      <view class="input-group">
        <text class="input-label">报废原因</text>
        <input class="input-field" value="{{wasteReason}}" bindinput="onWasteReasonInput" placeholder="过期 / 变质 / 其他" />
      </view>
      <button class="btn btn-danger btn-block mt-md" bindtap="submitWaste">确认报废</button>
    </view>
  </view>

  <!-- OCR 结果弹窗 -->
  <view wx:if="{{showOcrModal}}" class="modal-mask" bindtap="closeOcrModal">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">识别结果</text>
        <text class="modal-close" bindtap="closeOcrModal">✕</text>
      </view>
      <view wx:for="{{ocrResults}}" wx:key="index" class="ocr-item">
        <input class="input-field" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="onOcrInput" placeholder="食材名称" />
        <input class="input-field" type="digit" value="{{item.quantity}}" data-index="{{index}}" data-field="quantity" bindinput="onOcrInput" placeholder="数量" />
        <text class="ocr-del" data-index="{{index}}" bindtap="deleteOcrItem">✕</text>
      </view>
      <view class="btn-row">
        <button class="btn btn-secondary" bindtap="addOcrItem">＋ 添加一行</button>
        <button class="btn btn-primary" bindtap="submitOcrResults">确认入库</button>
      </view>
    </view>
  </view>
</view>
