.container {
  padding: 30rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  margin-bottom: 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.search-bar {
  margin-bottom: 20rpx;
}

.search-input {
  width: 100%;
  height: 72rpx;
  background-color: #fff;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.date-filter {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
}

.date-picker {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: #333;
}

.date-picker.placeholder {
  color: #999;
}

.date-separator {
  color: #999;
  font-size: 26rpx;
}

.clear-date {
  padding: 10rpx 20rpx;
  background-color: #ff4d4f;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.tabs {
  display: flex;
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.tab-item.active {
  color: #1890ff;
  font-weight: bold;
  background-color: rgba(24, 144, 255, 0.1);
}

.logs-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.log-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.log-info {
  flex: 1;
}

.log-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.log-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.log-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

.log-right {
  text-align: right;
}

.log-quantity {
  font-size: 32rpx;
  font-weight: bold;
}

.log-quantity.in {
  color: #52c41a;
}

.log-quantity.out {
  color: #ff4d4f;
}

.log-quantity.waste {
  color: #faad14;
}

.log-balance {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}

.loading {
  text-align: center;
  padding: 30rpx;
  color: #999;
}
