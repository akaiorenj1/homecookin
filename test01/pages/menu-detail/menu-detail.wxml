<view wx:if="{{recipe}}" class="container">
  <!-- 图片 -->
  <view class="detail-img-wrap">
    <image wx:if="{{recipe.image}}" src="{{recipe.image}}" mode="aspectFill" class="detail-img" />
    <text wx:else class="detail-img-placeholder">🍲</text>
    <view class="detail-meta">
      <text class="detail-time">⏱ {{recipe.cookingTime}} 分钟</text>
      <text class="detail-cat">📂 {{recipe.category === 'main' ? '菜品' : recipe.category === 'drink' ? '饮品' : '甜品'}}</text>
    </view>
  </view>

  <!-- 菜名 -->
  <text class="detail-name">{{recipe.name}}</text>

  <!-- 食材列表 -->
  <view class="card mt-md">
    <text class="section-title">所需食材</text>
    <view wx:if="{{recipe.ingredients.length > 0}}" class="ingredient-list">
      <view wx:for="{{recipe.ingredients}}" wx:key="index" class="ingredient-item">
        <text class="ing-dot">•</text>
        <text class="ing-name">{{item.ingredientName}}</text>
        <text class="ing-qty">{{item.quantity}}{{item.unit}}</text>
      </view>
    </view>
    <text wx:else class="empty-text">暂无食材信息</text>
  </view>

  <!-- 做法 -->
  <view wx:if="{{recipe.method}}" class="card mt-md">
    <text class="section-title">制作方法</text>
    <text class="method-text">{{recipe.method}}</text>
  </view>

  <!-- 点菜按钮 -->
  <view class="bottom-bar">
    <button class="btn btn-primary btn-block" bindtap="orderRecipe">
      点这道菜 🍳
    </button>
  </view>
</view>

<view wx:elif="{{loading}}" class="loading-container">
  <text>加载中...</text>
</view>
