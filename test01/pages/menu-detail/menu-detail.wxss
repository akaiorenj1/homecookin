.detail-img-wrap {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.detail-img {
  width: 100%;
  height: 400rpx;
  object-fit: cover;
}

.detail-img-placeholder {
  width: 100%;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  background: var(--color-bg);
}

.detail-meta {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0,0,0,0.6));
  padding: 40rpx 24rpx 20rpx;
  display: flex;
  gap: 24rpx;
}

.detail-time, .detail-cat {
  font-size: var(--font-xs);
  color: rgba(255,255,255,0.9);
}

.detail-name {
  font-size: var(--font-xxl);
  font-weight: 800;
  color: var(--color-text);
}

.section-title {
  font-size: var(--font-md);
  font-weight: 700;
  margin-bottom: 16rpx;
  display: block;
}

.ingredient-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ingredient-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.ingredient-item:last-child {
  border-bottom: none;
}

.ing-dot {
  color: var(--color-primary);
  font-size: var(--font-md);
  margin-right: 12rpx;
}

.ing-name {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--color-text);
}

.ing-qty {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  font-weight: 500;
}

.method-text {
  font-size: var(--font-sm);
  line-height: 1.8;
  color: var(--color-text);
  white-space: pre-wrap;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--color-card);
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
}
