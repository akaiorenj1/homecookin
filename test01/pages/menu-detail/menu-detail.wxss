.recipe-header {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.recipe-image {
  width: 100%;
  height: 400rpx;
}

.recipe-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  padding: 20rpx;
}

.recipe-meta {
  padding: 0 20rpx 20rpx;
  display: flex;
  gap: 20rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #666;
}

.section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.ingredient-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ingredient-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
}

.ingredient-name {
  font-size: 28rpx;
  color: #333;
}

.ingredient-quantity {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 500;
}

.method-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 30rpx;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.order-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  padding: 24rpx;
  border-radius: 50rpx;
}

.loading-container,
.error-container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60vh;
  color: #999;
  font-size: 28rpx;
}
