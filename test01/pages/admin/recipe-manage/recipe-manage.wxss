.container {
  padding: 30rpx;
  padding-bottom: 150rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #5c4033;
  margin-bottom: 30rpx;
}

.category-tabs {
  display: flex;
  background-color: #fff8dc;
  padding: 16rpx 0;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  border: 3rpx solid #8b4513;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #8b4513;
  padding: 12rpx 0;
  font-weight: bold;
}

.tab-item.active {
  color: #fff8dc;
  background-color: #6b8e23;
}

.menu-list {
  padding-bottom: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  background-color: #fff8dc;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  border: 3rpx solid #8b4513;
  box-shadow: 4rpx 4rpx 0 rgba(139, 69, 19, 0.2);
}

.menu-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background-color: #f5deb3;
  border: 2rpx solid #8b4513;
}

.menu-info {
  flex: 1;
  margin-left: 16rpx;
}

.menu-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #5c4033;
}

.menu-time {
  font-size: 22rpx;
  color: #a0522d;
  margin-top: 6rpx;
}

.menu-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.action-btn {
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: bold;
  border: 2rpx solid #3d4a1d;
}

.action-btn.edit {
  background-color: #6b8e23;
  color: #fff8dc;
}

.action-btn.delete {
  background-color: #cd5c5c;
  color: #fff8dc;
}

.empty-tip {
  text-align: center;
  color: #a0522d;
  padding: 60rpx 0;
  font-size: 26rpx;
}

.loading {
  text-align: center;
  padding: 30rpx;
  color: #a0522d;
}

.add-btn {
  position: fixed;
  right: 40rpx;
  bottom: 40rpx;
  width: 96rpx;
  height: 96rpx;
  background-color: #cd853f;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #8b4513;
  box-shadow: 4rpx 4rpx 0 #8b4513;
}

.add-btn text {
  font-size: 56rpx;
  color: #fff8dc;
  font-weight: bold;
}
