.container {
  padding: 30rpx;
  padding-bottom: 150rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #5c4033;
}

.form {
  background-color: #fff8dc;
  border-radius: 16rpx;
  padding: 30rpx;
  border: 3rpx solid #8b4513;
  box-shadow: 4rpx 4rpx 0 rgba(139, 69, 19, 0.2);
  box-sizing: border-box;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #8b4513;
  margin-bottom: 14rpx;
  font-weight: bold;
}

.form-input {
  width: 100%;
  height: 72rpx;
  background-color: #fffaf0;
  border: 3rpx solid #8b4513;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  background-color: #fffaf0;
  border: 3rpx solid #8b4513;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.picker-value {
  width: 100%;
  height: 72rpx;
  background-color: #fffaf0;
  border: 3rpx solid #8b4513;
  border-radius: 8rpx;
  padding: 0 20rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.image-upload {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 3rpx solid #8b4513;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  width: 100%;
  height: 100%;
  background-color: #fffaf0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #8b4513;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.upload-icon {
  font-size: 56rpx;
  color: #8b4513;
  line-height: 1;
}

.upload-text {
  font-size: 22rpx;
  color: #a0522d;
  margin-top: 8rpx;
}

.section {
  margin-top: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #5c4033;
}

.add-ingredient-btn {
  background-color: #6b8e23;
  color: #fff8dc;
  font-size: 22rpx;
  font-weight: bold;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  border: 2rpx solid #3d4a1d;
}

.ingredient-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.ingredient-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx;
  background-color: #fffaf0;
  border-radius: 8rpx;
  border: 2rpx solid #deb887;
  box-sizing: border-box;
}

.ingredient-info {
  flex: 1;
}

.ingredient-name {
  font-size: 26rpx;
  color: #5c4033;
  font-weight: bold;
}

.ingredient-quantity {
  font-size: 24rpx;
  color: #6b8e23;
  margin-left: 14rpx;
  font-weight: bold;
}

.delete-btn {
  color: #cd5c5c;
  font-size: 22rpx;
  font-weight: bold;
}

.empty-tip {
  text-align: center;
  color: #a0522d;
  padding: 30rpx;
}

.actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #f4e4bc;
  border-top: 3rpx solid #8b4513;
  box-sizing: border-box;
}

.btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: 3rpx solid #3d4a1d;
}

.btn.cancel {
  background-color: #f5deb3;
  color: #5c4033;
}

.btn.confirm {
  background-color: #6b8e23;
  color: #fff8dc;
  box-shadow: 3rpx 3rpx 0 #3d4a1d;
}

.ingredient-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(92, 64, 51, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.ingredient-modal .modal-content {
  width: 80%;
  background-color: #fff8dc;
  border-radius: 16rpx;
  padding: 30rpx;
  border: 4rpx solid #8b4513;
  box-shadow: 6rpx 6rpx 0 rgba(139, 69, 19, 0.4);
  box-sizing: border-box;
}

.modal-title {
  font-size: 30rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
  color: #5c4033;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.modal-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: bold;
  border: 3rpx solid #3d4a1d;
}

.modal-btn.cancel {
  background-color: #f5deb3;
  color: #5c4033;
}

.modal-btn.confirm {
  background-color: #6b8e23;
  color: #fff8dc;
  box-shadow: 3rpx 3rpx 0 #3d4a1d;
}
