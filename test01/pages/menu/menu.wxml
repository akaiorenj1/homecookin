<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input 
      class="search-input" 
      placeholder="搜索菜谱..." 
      bindinput="onSearchInput" 
      value="{{searchKeyword}}"
    />
    <text class="search-icon">🔍</text>
  </view>

  <!-- 分类标签 -->
  <scroll-view scroll-x class="category-bar">
    <view 
      wx:for="{{categories}}" 
      wx:key="value" 
      class="category-item {{currentCategory === item.value ? 'active' : ''}}"
      data-category="{{item.value}}"
      bindtap="switchCategory"
    >{{item.label}}</view>
  </scroll-view>

  <!-- 菜谱列表 -->
  <view wx:if="{{!loading && menuList.length === 0}}" class="empty-state">
    <text class="empty-icon">🍽️</text>
    <text class="empty-text">暂无菜谱</text>
    <button class="btn btn-primary mt-lg" bindtap="goToAddRecipe">添加菜谱</button>
  </view>

  <view wx:elif="{{!loading}}" class="recipe-grid">
    <view 
      wx:for="{{menuList}}" 
      wx:key="_id" 
      class="recipe-card card card--hover"
      bindtap="goToDetail"
      bindlongpress="quickOrder"
      data-id="{{item._id}}"
      data-item="{{item}}"
    >
      <view class="recipe-img-wrap">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="recipe-img" />
        <text wx:else class="recipe-img-placeholder">🍲</text>
        <view class="recipe-time-tag">
          <text>{{item.cookingTime}}min</text>
        </view>
      </view>
      <view class="recipe-info">
        <text class="recipe-name">{{item.name}}</text>
        <text class="recipe-ing-count">{{item.ingredients.length}} 种食材</text>
      </view>
    </view>
  </view>

  <view wx:else class="loading-container">
    <text>加载中...</text>
  </view>

  <!-- 添加按钮 -->
  <view class="fab" bindtap="goToAddRecipe">
    <text class="fab-icon">+</text>
  </view>
</view>
