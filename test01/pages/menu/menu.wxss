/* 搜索栏 */
.search-bar {
  position: relative;
  margin-bottom: 16rpx;
}

.search-input {
  width: 100%;
  background: var(--color-card);
  border-radius: var(--radius-full);
  padding: 20rpx 48rpx 20rpx 40rpx;
  font-size: var(--font-sm);
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}

.search-icon {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: var(--font-md);
  opacity: 0.5;
}

/* 菜谱网格 */
.recipe-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding-top: 16rpx;
}

.recipe-card {
  overflow: hidden;
  padding: 0;
}

.recipe-img-wrap {
  position: relative;
  width: 100%;
  height: 240rpx;
}

.recipe-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.recipe-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  background: var(--color-bg);
}

.recipe-time-tag {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  font-size: var(--font-xs);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
}

.recipe-info {
  padding: 16rpx 20rpx 20rpx;
}

.recipe-name {
  display: block;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recipe-ing-count {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

/* FAB 添加按钮 */
.fab {
  position: fixed;
  bottom: 120rpx;
  right: 40rpx;
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255,107,53,0.4);
  z-index: 50;
}

.fab-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}
