.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #6b8e23 0%, #556b2f 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.login-card {
  width: 100%;
  background-color: #fff8dc;
  border-radius: 20rpx;
  padding: 50rpx 30rpx;
  text-align: center;
  border: 4rpx solid #8b4513;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.3);
}

.app-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #5c4033;
  margin-bottom: 8rpx;
}

.app-desc {
  font-size: 24rpx;
  color: #8b4513;
  margin-bottom: 40rpx;
}

.input-group {
  margin-bottom: 24rpx;
}

.password-input {
  width: 100%;
  height: 72rpx;
  background-color: #fffaf0;
  border: 3rpx solid #8b4513;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  text-align: center;
  box-sizing: border-box;
}

.error-tip {
  color: #cd5c5c;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.login-btn {
  background: linear-gradient(180deg, #6b8e23 0%, #556b2f 100%);
  color: #fff8dc;
  font-size: 28rpx;
  font-weight: bold;
  padding: 18rpx 50rpx;
  border-radius: 10rpx;
  border: 3rpx solid #3d4a1d;
  box-shadow: 3rpx 3rpx 0 #3d4a1d;
}

.login-btn::after {
  border: none;
}

.tips {
  margin-top: 30rpx;
  font-size: 20rpx;
  color: #a0522d;
}
