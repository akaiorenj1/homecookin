<view class="container">
  <view class="login-card">
    <view class="app-name">🏠 家常厨房</view>
    <view class="app-desc">请输入访问密码</view>
    
    <view class="input-group">
      <input 
        class="password-input" 
        password 
        placeholder="请输入访问密码" 
        bindinput="onPasswordInput"
        value="{{password}}"
      />
    </view>
    
    <view class="error-tip" wx:if="{{errorMsg}}">
      {{errorMsg}}
    </view>
    
    <button class="login-btn" bindtap="doLogin">确认</button>
    
    <view class="tips">
      <text>仅限授权用户访问</text>
    </view>
  </view>
</view>
