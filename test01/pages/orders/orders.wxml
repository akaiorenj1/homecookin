<view class="container">
  <text class="page-date">📅 {{today}}</text>

  <!-- 采购清单 -->
  <view wx:if="{{shoppingList.length > 0}}" class="shopping-card card">
    <view class="shop-header">
      <text class="shop-title">🛒 采购清单</text>
      <text class="shop-copy" bindtap="copyShoppingList">复制</text>
    </view>
    <view wx:for="{{shoppingList}}" wx:key="name" class="shop-item">
      <text class="shop-name">{{item.name}}</text>
      <text class="shop-diff">缺 {{item.needQuantity}}{{item.unit}}</text>
    </view>
  </view>

  <!-- 订单 Tab -->
  <view class="order-tabs">
    <view class="tab-item {{currentTab === 'pending' ? 'active' : ''}}" data-tab="pending" bindtap="switchTab">
      <text>待处理</text>
    </view>
    <view class="tab-item {{currentTab === 'completed' ? 'active' : ''}}" data-tab="completed" bindtap="switchTab">
      <text>已完成</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <view wx:if="{{!loading && ordersList.length === 0}}" class="empty-state">
    <text class="empty-icon">📋</text>
    <text class="empty-text">{{currentTab === 'pending' ? '暂无待处理订单' : '暂无已完成订单'}}</text>
  </view>

  <view wx:elif="{{!loading}}" class="order-list">
    <view wx:for="{{ordersList}}" wx:key="_id" class="order-card card">
      <view class="order-top">
        <view class="order-info">
          <text class="order-name">{{item.recipeName}}</text>
          <text class="order-time">{{item.createDateFormat}}</text>
        </view>
        <view wx:if="{{currentTab === 'pending'}}" class="order-ops">
          <text class="op-complete" data-id="{{item._id}}" bindtap="completeOrder">✓</text>
          <text class="op-delete" data-id="{{item._id}}" data-name="{{item.recipeName}}" bindtap="deleteOrder">✕</text>
        </view>
      </view>
      <view wx:if="{{item.ingredients && item.ingredients.length > 0}}" class="order-ingredients">
        <text wx:for="{{item.ingredients}}" wx:key="ingredientName" wx:for-item="ing" class="order-ing-tag">
          {{ing.ingredientName}} {{ing.quantity}}{{ing.unit}}
        </text>
      </view>
    </view>
  </view>

  <view wx:else class="loading-container"><text>加载中...</text></view>
</view>
