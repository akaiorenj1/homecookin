.orders-header {
  background: linear-gradient(180deg, #cd853f 0%, #a0522d 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border: 4rpx solid #8b4513;
  box-shadow: 4rpx 4rpx 0 #8b4513;
}

.orders-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff8dc;
  text-shadow: 2rpx 2rpx 0 #8b4513;
}

.orders-date {
  font-size: 22rpx;
  color: #deb887;
  margin-top: 8rpx;
}

.tabs {
  display: flex;
  background-color: #fff8dc;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  border: 3rpx solid #8b4513;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #8b4513;
}

.tab-item.active {
  color: #fff8dc;
  font-weight: bold;
  background-color: #cd853f;
}

.orders-list {
  padding-bottom: 20rpx;
}

.order-item {
  display: flex;
  align-items: center;
  background-color: #fff8dc;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 3rpx solid #8b4513;
  box-shadow: 4rpx 4rpx 0 rgba(139, 69, 19, 0.2);
}

.order-image {
  width: 110rpx;
  height: 110rpx;
  border-radius: 8rpx;
  background-color: #f5deb3;
  border: 2rpx solid #8b4513;
}

.order-info {
  flex: 1;
  margin-left: 16rpx;
}

.order-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #5c4033;
}

.order-time {
  font-size: 20rpx;
  color: #a0522d;
  margin-top: 6rpx;
}

.order-actions {
  display: flex;
  gap: 10rpx;
}

.order-btn {
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: bold;
  border: 2rpx solid #3d4a1d;
}

.order-btn.delete {
  background-color: #f5deb3;
  color: #8b4513;
}

.order-btn.complete {
  background-color: #cd853f;
  color: #fff8dc;
  box-shadow: 2rpx 2rpx 0 #8b4513;
}

.order-status {
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: bold;
  background-color: #cd853f;
  color: #fff8dc;
  border: 2rpx solid #8b4513;
}

.order-status.completed {
  background-color: #6b8e23;
  border-color: #3d4a1d;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #a0522d;
}

.loading {
  text-align: center;
  padding: 30rpx;
  color: #a0522d;
}

.shopping-suggestion {
  background-color: #fff8dc;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  border: 3rpx solid #8b4513;
  box-shadow: 4rpx 4rpx 0 rgba(139, 69, 19, 0.2);
}

.suggestion-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #cd853f;
  margin-bottom: 14rpx;
}

.suggestion-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.suggestion-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx;
  background-color: #fffaf0;
  border-radius: 8rpx;
  border: 2rpx solid #deb887;
}

.suggestion-left {
  display: flex;
  flex-direction: column;
}

.suggestion-name {
  font-size: 26rpx;
  color: #5c4033;
  font-weight: bold;
}

.suggestion-current {
  font-size: 20rpx;
  color: #a0522d;
  margin-top: 4rpx;
}

.suggestion-quantity {
  font-size: 26rpx;
  color: #cd853f;
  font-weight: bold;
}
