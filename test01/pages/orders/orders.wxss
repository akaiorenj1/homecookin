.page-date {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: 24rpx;
  display: block;
}

/* 采购清单 */
.shopping-card {
  background: linear-gradient(135deg, rgba(0,184,148,0.06), rgba(0,184,148,0.02));
  border: 2rpx solid rgba(0,184,148,0.2);
}

.shop-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.shop-title {
  font-size: var(--font-md);
  font-weight: 700;
}

.shop-copy {
  font-size: var(--font-xs);
  color: var(--color-primary);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
  background: rgba(255,107,53,0.1);
}

.shop-item {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}

.shop-name {
  font-size: var(--font-sm);
  color: var(--color-text);
}

.shop-diff {
  font-size: var(--font-sm);
  color: var(--color-danger);
  font-weight: 600;
}

/* 订单 Tab */
.order-tabs {
  display: flex;
  margin-bottom: 24rpx;
  background: var(--color-card);
  border-radius: var(--radius-full);
  padding: 6rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  transition: all 0.2s;
}

.tab-item.active {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255,107,53,0.3);
}

/* 订单卡片 */
.order-card {
  padding: 24rpx;
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-info {
  flex: 1;
}

.order-name {
  display: block;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 4rpx;
}

.order-time {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

.order-ops {
  display: flex;
  gap: 12rpx;
}

.op-complete, .op-delete {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-md);
}

.op-complete {
  background: rgba(0,184,148,0.1);
  color: var(--color-success);
}

.op-delete {
  background: rgba(255,71,87,0.1);
  color: var(--color-danger);
}

.order-ingredients {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.order-ing-tag {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  background: var(--color-bg);
  padding: 6rpx 14rpx;
  border-radius: var(--radius-full);
}
